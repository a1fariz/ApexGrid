# ApexGrid Environment Variables Configuration Template

# ==========================================
# 1. Database Configuration
# ==========================================
DB_USERNAME=apex
DB_PASSWORD=apex123

# ==========================================
# 2. JWT Configuration
# ==========================================
# Secret key used for signing user authentication tokens
JWT_SECRET=apexgrid-super-secret-key-for-jwt-2026-development-only

# ==========================================
# 3. Inter-Service Communication Security
# ==========================================
# Shared secret key validating gateway authentication headers
INTERNAL_SECRET=apexgrid-internal-service-secret-2026

# ==========================================
# 4. SMTP / Mail Server Configuration
# ==========================================
# Host name of the SMTP server (e.g. smtp.gmail.com)
MAIL_HOST=smtp.gmail.com
# Port used for connection (typically 587 for TLS or 465 for SSL)
MAIL_PORT=587
# Authentication credentials for the sending email mailbox
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-smtp-app-password
